# Copy to `.env` in the project root (or merge these lines into your existing `.env`).

# --- Option A: Claude for horizon insights ---
# 1. Set VITE_INSIGHTS_PROVIDER=claude (below).
# 2. Put your real key in ANTHROPIC_API_KEY.
# 3. Run: npm run dev:coach-proxy  AND  npm run dev  (restart Vite after any VITE_* change).
# 4. In the app, use Regenerate on insights if you still see old text (cached in localStorage).

# --- Anthropic (coach proxy: npm run dev:coach-proxy) ---
# Full key from https://console.anthropic.com/settings/keys — must start with sk-ant- (often sk-ant-api03-...).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Optional override; default matches Anthropic docs.
# ANTHROPIC_VERSION=2023-06-01
COACH_PROXY_PORT=8787

# --- Vite: required for Claude insights (restart dev server after changing) ---
VITE_INSIGHTS_PROVIDER=claude
# Optional label in the insights modal:
# VITE_INSIGHTS_MODEL_LABEL=Claude Sonnet
# To use local Ollama for insights instead of Claude, set:
# VITE_INSIGHTS_PROVIDER=ollama
# Production: base URL of your deployed proxy (path must serve POST .../insights)
# VITE_COACH_PROXY_URL=https://your-deployed-proxy.example/api/coach
